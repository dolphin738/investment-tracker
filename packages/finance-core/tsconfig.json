{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 消费方目前只有 backend（NestJS / CommonJS），故本包输出 CommonJS，
    // 保证 require 互操作无损；本包自身零运行时依赖，不受此选择约束。
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
