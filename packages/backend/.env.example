# ==================== 投资收益统计系统 — 后端环境变量 ====================
# 复制此文件为 .env 并填入实际值

# ---- 数据库 ----
# PostgreSQL 连接字符串（格式：postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/investment_tracker?schema=public"

# ---- JWT 认证 ----
# JWT 密钥（生产环境请使用强随机字符串，至少 32 位）
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
# JWT 过期时间
JWT_EXPIRES_IN="7d"

# ---- HTTP 服务 ----
# 服务端口
PORT=3000
# CORS 允许的源（开发环境用逗号分隔多个源，生产环境填实际域名）
# 开发：http://localhost:5173,http://localhost:5174
# 生产：https://your-domain.com
CORS_ORIGIN="http://localhost:5173"

# ---- 文件上传 ----
# 上传根目录。留空则默认 packages/backend/uploads（相对启动目录 process.cwd() 解析）。
# 生产环境请填绝对路径并挂载持久卷，否则容器重建后用户头像会全部丢失。
# 示例：UPLOAD_DIR="/var/lib/investment-tracker/uploads"
UPLOAD_DIR=

# 存储驱动：local（本地磁盘，默认）。cos / s3 为预留值，当前未实现，会回退到 local。
STORAGE_DRIVER=local

# ---- API 文档 ----
# Swagger 文档路径前缀（完整路径：/api/docs）
SWAGGER_PATH="docs"

# ---- 应用配置 ----
# 运行环境
NODE_ENV="development"
