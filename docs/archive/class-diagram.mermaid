classDiagram
    direction TB

    class User {
        +String id
        +String email
        +String passwordHash
        +String name
        +String avatar
        +String phone
        +String bio
        +DateTime createdAt
    }

    class UserPreference {
        +String id
        +String userId
        +String defaultPortfolioId
        +String defaultGranularity
        +String defaultDateRange
        +String aggregation
        +Int weekStartsOn
        +Int navDecimals
        +Int xirrDecimals
        +String theme
        +Int staleDays
    }

    class Portfolio {
        +String id
        +String userId
        +String name
        +String description
        +Date baseDate
        +String currency
        +DateTime archivedAt
    }

    class Security {
        +String id
        +String portfolioId
        +String code
        +String name
        +SecurityType type
        +String currency
    }

    class Holding {
        +String id
        +String portfolioId
        +String securityId
        +Date date
        +Decimal quantity
        +Decimal avgCost
        +Decimal marketPrice
        +String note
    }

    class Transaction {
        +String id
        +String portfolioId
        +Date date
        +TransactionType type
        +Decimal amount
        +String securityId
        +Decimal quantity
        +Decimal price
        +Decimal fee
        +String note
    }

    class AssetSnapshot {
        +String id
        +String portfolioId
        +Date date
        +Decimal totalAsset
        +String note
    }

    class DailyNav {
        +String id
        +String portfolioId
        +Date date
        +Decimal unitNav
        +Decimal cumulativeNav
        +Decimal yearNav
        +Decimal shares
        +Decimal baseCumulativeNav
    }

    class DailyXirr {
        +String id
        +String portfolioId
        +Date date
        +Decimal xirrValue
    }

    class DividendRecord {
        +String id
        +String portfolioId
        +String securityId
        +Date date
        +Decimal amount
        +DividendType type
        +String note
    }

    class FeeRecord {
        +String id
        +String portfolioId
        +String securityId
        +Date date
        +Decimal amount
        +FeeType type
        +String transactionId
        +String note
    }

    %% 关系
    User "1" --> "0..1" UserPreference : has
    User "1" --> "*" Portfolio : owns
    Portfolio "1" --> "*" Security : contains
    Portfolio "1" --> "*" Holding : contains
    Portfolio "1" --> "*" Transaction : contains
    Portfolio "1" --> "*" AssetSnapshot : contains
    Portfolio "1" --> "*" DailyNav : contains
    Portfolio "1" --> "*" DailyXirr : contains
    Portfolio "1" --> "*" DividendRecord : contains
    Portfolio "1" --> "*" FeeRecord : contains
    Security "1" --> "*" Holding : references
    Security "1" --> "0..*" Transaction : optionally_ref
    Security "1" --> "*" DividendRecord : references
    Security "1" --> "*" FeeRecord : references

    %% 计算引擎隔离标注
    note for DailyNav "计算引擎输入:<br/>AssetSnapshot + Transaction"
    note for DailyXirr "计算引擎输入:<br/>AssetSnapshot + Transaction"
    note for Holding "永不进入计算引擎<br/>(C-08/C-09)"
    note for DividendRecord "永不进入计算引擎"
    note for FeeRecord "永不进入计算引擎"
