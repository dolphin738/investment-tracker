# 后端运行环境变量示例（复制为 .env 后按需修改）
# ⚠️ JWT_SECRET 必须为 ≥32 字节随机串（HS256 安全下限，PyJWT 2.13+ 会警告短密钥）。
# 生成方式：openssl rand -base64 32
# 下面这串仅为本地开发占位（免 InsecureKeyLengthWarning 用），生产/真实环境务必换独立随机串！
JWT_SECRET=YeYdWyWAvxCrQ169N5ITu2ZlwqRmsoTIH6O7v9Li2-E
DATABASE_URL=postgresql+asyncpg://investment_app:CHANGE_ME@127.0.0.1:5432/investment_tracker
UPLOAD_DIR=uploads
STATIC_ASSETS_PREFIX=/api/uploads
CORS_ORIGINS=["http://localhost:5173"]
ACCOUNT_RETENTION_DAYS=30
