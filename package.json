{
  "name": "investment-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "投资收益统计系统 — 基于 XIRR 的多端投资组合收益与净值追踪平台",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "cd packages/backend && node ../../node_modules/@nestjs/cli/bin/nest.js start --watch",
    "dev:web": "cd packages/web && node ../../node_modules/vite/bin/vite.js",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "turbo run format",
    "db:format": "cd packages/backend && node ../../node_modules/prisma/build/index.js format",
    "db:generate": "cd packages/backend && node ../../node_modules/prisma/build/index.js generate",
    "db:migrate": "cd packages/backend && node ../../node_modules/prisma/build/index.js migrate dev",
    "db:seed": "cd packages/backend && node ../../node_modules/prisma/build/index.js db seed",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.9.0",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
