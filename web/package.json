{
  "name": "@investment-tracker/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Investment Tracker Web Frontend (Vue 3) - Vite + Vue 3 + Tailwind 3 + shadcn-vue",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "lint": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:e2e": "vue-tsc --noEmit -p tsconfig.e2e.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.51.0",
    "axios": "^1.6.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "echarts": "^5.5.0",
    "lucide-vue-next": "^0.460.0",
    "pinia": "^2.2.0",
    "reka-ui": "^2.0.0",
    "tailwind-merge": "^2.2.0",
    "vee-validate": "^4.12.0",
    "vue": "^3.5.0",
    "vue-draggable-plus": "^0.5.0",
    "vue-echarts": "^7.0.0",
    "vue-router": "^4.4.0",
    "vue-sonner": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "autoprefixer": "^10.4.18",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.0",
    "vite": "^5.1.0",
    "vitest": "^1.2.2",
    "vue-tsc": "^2.1.0"
  }
}
