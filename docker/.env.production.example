# 生产环境环境变量示例（复制为生产 .env 或注入到部署平台机密）
# ⚠️ 以下值必须由部署方替换为真实强随机串/连接串，禁止把真实密钥提交进仓库。

# JWT 签名密钥：≥32 字节随机串（HS256 安全下限）
# 生成：openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_32BYTE_SECRET

# 数据库（生产实例）
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/investment_return_tracker

# 测试库（与开发库物理隔离，pytest 由 conftest 自动建库+建表）
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/investment_return_tracker_test

# 上传目录与静态前缀
UPLOAD_DIR=uploads
STATIC_ASSETS_PREFIX=/api/uploads

# CORS 源（生产前端域名，JSON 数组字符串，逗号分隔）
CORS_ORIGINS=["https://your-domain.example"]

# 账户注销冷静期（天）
ACCOUNT_RETENTION_DAYS=30

# 内部清理端点令牌（POST /api/internal/cleanup/* 的 X-Internal-Token，必须强随机）
INTERNAL_CLEANUP_TOKEN=REPLACE_WITH_STRONG_RANDOM_INTERNAL_TOKEN

# ★ 生产安全严格模式（REP-002）：开启后检测到弱密钥/弱默认直接拒绝启动。
# 开发/测试环境请勿开启（保持默认 False 以免启动失败）。
STRICT_SECURITY=1

# 登录失败限速（REP-010）：每 (IP, 邮箱) 窗口内失败次数上限；内网可设 0 关闭。
LOGIN_RATE_LIMIT_PER_MINUTE=20

# 公开注册开关（REP-010）：单用户/内网部署可设为 false 关闭公开注册。
REGISTRATION_ENABLED=true
